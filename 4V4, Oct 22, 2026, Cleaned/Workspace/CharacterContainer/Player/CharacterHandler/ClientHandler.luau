function nutmeg(argument)
    enabled_3 = true

    task.delay(1.5, function()
        enabled_3 = false
    end)

    number = 0
    local negated_value = ((argument ~= "Left") and 10) or -10
    (((argument == "Left") and nutmeg_l_track) or nutmeg_r_track):Play(0, 1, 0.95)
    local number_9 = 10
    local character_2 = game.Players.LocalPlayer.Character

    for _, child in pairs(character_2.HumanoidRootPart:GetChildren()) do
        if child:IsA("BodyVelocity") then
            child:Destroy()
        end
    end

    game.ReplicatedStorage.Remotes.NutmegCD:FireServer(ball_status.lastKicked.Value)
    local clone = game.ReplicatedStorage.SFX.Boom:Clone()
    clone.Parent = game.Workspace
    clone:Play()
    game.Debris:AddItem(clone, 10)
    local _, value = character_2.HumanoidRootPart.CFrame:ToOrientation()
    local cframe = character_2.HumanoidRootPart.CFrame
    local body_velocity = Instance.new("BodyVelocity")
    body_velocity.MaxForce = Vector3.new(50000, 0, 50000)
    body_velocity.Velocity = character_2.HumanoidRootPart.CFrame.lookVector * number_9
        + (character_2.HumanoidRootPart.CFrame.rightVector * negated_value)
    body_velocity.Parent = character_2.HumanoidRootPart
