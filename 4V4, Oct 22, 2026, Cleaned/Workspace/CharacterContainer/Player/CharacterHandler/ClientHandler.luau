GetClientKickInfo.OnClientInvoke = function()
    local keys_down = {}

    for _, input in pairs(user_input_service:GetKeysPressed()) do
        table.insert(keys_down, input.KeyCode)
    end

    local ball = game.Workspace.Temp:FindFirstChild("Ball")

    if user_input_service.GamepadEnabled then
        if number_4 == 2 then
            local values_2 = { Enum.KeyCode.A }
            keys_down = values_2
        elseif number_4 == 3 then
            keys_down = { Enum.KeyCode.D }
        elseif number_4 == 1 then
            keys_down = { Enum.KeyCode.S }
        elseif number_4 == 4 then
            keys_down = { Enum.KeyCode.W }
        end
    end

    local value = nil
    local side

    if ball == nil then
        side = value
    else
        side = (
            (
                character.HumanoidRootPart.CFrame.RightVector:Dot(
                    ((character.HumanoidRootPart.Position * Vector3.new(1, 0, 1)) - (ball.Position * Vector3.new(
                        1,
                        0,
                        1
                    ))).Unit
                ) > 0
            ) and "Left"
        ) or "Right"
    end

    ball = { cameraLook = 0, charge = 0, side = 0, isAir = 0, moveDirection = 0, keysDown = 0 }
    ball.look = character.HumanoidRootPart.CFrame.lookVector
    ball.right = character.HumanoidRootPart.CFrame.rightVector
    ball.pos = character.HumanoidRootPart.CFrame
    ball.charge = ((charge_2 < charge) and charge) or charge_2
    ball.cameraLook = game.Workspace.CurrentCamera.CFrame.LookVector
    ball.isAir = status:FindFirstChild("spaceCheck") ~= nil
    ball.moveDirection = character.HumanoidRootPart.AssemblyLinearVelocity.Unit
    ball.keysDown = keys_down
    ball.side = side

    return ball
end
