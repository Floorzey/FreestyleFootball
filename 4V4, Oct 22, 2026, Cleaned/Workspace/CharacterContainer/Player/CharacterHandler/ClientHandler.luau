function shove()
    if
        local_player.SelectedPosition.Value == "GK" and status:FindFirstChild("InBox")
        or status:FindFirstChild("Knockdown")
        or not local_player:FindFirstChild("InPlay")
        or enabled_5 == true
    then
        return
