    local condition = status:FindFirstChild("Walled") ~= nil
    local tween

    if condition then
        tween = hitbox_handler_players.Create(
            { size = Vector3.new(7.5, 6, 9), cframe = character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 0) },
            character
        )
    else
        tween = hitbox_handler_players.Create(
            { size = Vector3.new(6, 6, 6), cframe = character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2) },
            character
        )
    end

    local value = nil
    local items = {}

    for _, item in pairs(tween) do
        local parent = item.Parent
        local player_from_character = game.Players:GetPlayerFromCharacter(parent)

        if
            (
                    not player_from_character
                    or player_from_character.SelectedTeam.Value ~= local_player.SelectedTeam.Value
                )
                and player_from_character
                and condition
            or (
                    not player_from_character
                    or player_from_character.SelectedTeam.Value ~= local_player.SelectedTeam.Value
                )
                and player_from_character
                and not condition
                and ball_status.lastKicked.Value ~= player_from_character
                and not (parent.HumanoidRootPart.CFrame.LookVector:Dot(
                    character.HumanoidRootPart.CFrame.LookVector.Unit
                ) < 0.7)
                and (type(parent.HumanoidRootPart.AssemblyLinearVelocity.X) ~= "number" and type(
                    parent.HumanoidRootPart.AssemblyLinearVelocity.Z
                ) ~= "number" or not (parent.HumanoidRootPart.AssemblyLinearVelocity:Dot(
                    character.HumanoidRootPart.AssemblyLinearVelocity
                ) < 0.7))
                and (type(parent.HumanoidRootPart.AssemblyLinearVelocity.X) == "number" or type(
                    parent.HumanoidRootPart.AssemblyLinearVelocity.Z
                ) == "number")
        then
            local humanoid = parent:FindFirstChild("Humanoid")

            if not humanoid then
                continue
            end

            local match_index = table.find(items, parent)

            if not match_index then
                table.insert(items, parent)
                value = (
                    (
                        character.HumanoidRootPart.CFrame.RightVector:Dot(
                            (
                                (character.HumanoidRootPart.Position * Vector3.new(1, 0, 1))
                                - (parent.HumanoidRootPart.Position * Vector3.new(1, 0, 1))
                            ).Unit
                        ) > 0
                    ) and "Left"
                ) or "Right"
                game.ReplicatedStorage.Remotes.ShoveCheck:FireServer(parent)
            end
        end
    end

    if not (#items > 0) then
        return
    end

    enabled_5 = true

    task.delay(10, function()
        enabled_5 = false
    end);

    (((value == "Left") and shove_l_track) or shove_r_track):Play(0, 1, 1)
end

