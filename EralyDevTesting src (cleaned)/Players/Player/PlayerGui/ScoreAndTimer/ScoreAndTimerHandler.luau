function handleScoreColor()
    local value = team_info.AwayTeamPoints.Value
    local value2 = team_info.HomeTeamPoints.Value

    if value2 < value then
        local value3 = team_info.CurrentAwayTeam.Value
        game:GetService("TweenService")
            :Create(score, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                BackgroundColor3 = values[value3],
            })
            :Play()
        game:GetService("TweenService")
            :Create(score.UIStroke, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                Thickness = 2,
                Color = values_2[value3],
            })
            :Play()
        game:GetService("TweenService")
            :Create(score.Score, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                TextStrokeColor3 = values_2[value3],
            })
            :Play()

        return
    end

    if value >= value2 then
        if value2 == value then
            local _ = team_info.CurrentAwayTeam.Value
            game:GetService("TweenService")
                :Create(score, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                    BackgroundColor3 = Color3.new(0, 0, 0),
                })
                :Play()
            game:GetService("TweenService")
                :Create(score.UIStroke, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                    Thickness = 1,
                    Color = Color3.new(1, 1, 1),
                })
                :Play()
            game:GetService("TweenService")
                :Create(score.Score, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                    TextStrokeColor3 = Color3.new(0, 0, 0),
                })
                :Play()
        end

        return
    end

    local value3_2 = team_info.CurrentHomeTeam.Value
    game:GetService("TweenService")
        :Create(score, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            BackgroundColor3 = values[value3_2],
        })
        :Play()
    game:GetService("TweenService")
        :Create(score.UIStroke, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Thickness = 2,
            Color = values_2[value3_2],
        })
        :Play()
    game:GetService("TweenService")
        :Create(score.Score, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            TextStrokeColor3 = values_2[value3_2],
        })
        :Play()
end

