    team2.TeamName.SurfaceGui.Frame.TextLabel.Text = values_5[team_info.CurrentAwayTeam.Value]
    team2.TeamName.SurfaceGui.Frame.TextLabel.TextStrokeColor3 = values[team_info.CurrentAwayTeam.Value]
        or Color3.new(1, 0.00784314, 0.00784314)
    team2.TeamName.SurfaceGui.Frame.TextLabel.TextStrokeTransparency = 1
    handleScoreColor()
end)

