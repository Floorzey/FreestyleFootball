function setupTabFrame()
    for _, player in pairs(game.Players:GetPlayers()) do
        if
            not (
                not player:FindFirstChild("dataLoaded")
                or player.SelectedTeam.Value == "N/A"
                or (player.SelectedTeam.Value == "Away" and container2 or container):FindFirstChild(player.Name)
            )
        then
            local current_away_team_value = player.SelectedTeam.Value == "Away" and team_info.CurrentAwayTeam.Value
                or team_info.CurrentHomeTeam.Value
            local clone = script.plrInfoTemplate:Clone()
            clone.UIGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, values[current_away_team_value]),
                ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
            })
            clone.UIStroke.UIGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, values_2[current_away_team_value]),
                ColorSequenceKeypoint.new(1, Color3.new(0.294118, 0.294118, 0.294118)),
            })
            clone.plrName.Text = string.upper(player.DisplayName)
            clone.POSITION.Text = player.SelectedPosition.Value
            clone.GOALS.Text = player.GoalsThisGame.Value
            clone.OOB.Text = player.PenaltyCount.Value
            clone.ASSISTS.Text = player.AssistsThisGame.Value
            clone.POINTS.Text = player.Points.Value
            clone.Name = player.Name
            clone.Parent = player.SelectedTeam.Value == "Away" and container2 or container
            local connection = player.SelectedPosition.Changed:Connect(function()
                if not clone:FindFirstChild("POSITION") then
                    return
                end

                clone.POSITION.Text = player.SelectedPosition.Value
            end)
            local connection_2 = player.GoalsThisGame.Changed:Connect(function()
                if not clone:FindFirstChild("GOALS") then
                    return
                end

                clone.GOALS.Text = player.GoalsThisGame.Value
            end)
            local connection_3 = player.PenaltyCount.Changed:Connect(function()
                if not clone:FindFirstChild("OOB") then
                    return
                end

                clone.OOB.Text = player.PenaltyCount.Value
            end)
            local connection_4 = player.AssistsThisGame.Changed:Connect(function()
                if not clone:FindFirstChild("ASSISTS") then
                    return
                end

                clone.ASSISTS.Text = player.AssistsThisGame.Value
            end)
            local connection_5 = player.Points.Changed:Connect(function()
                if not clone:FindFirstChild("POINTS") then
                    return
                end

                clone.POINTS.Text = player.Points.Value
            end)
            local connection_6 = player.OffsideCount.Changed:Connect(function()
                if not clone:FindFirstChild("OFFSIDES") then
                    return
                end

                clone.OFFSIDES.Text = player.OffsideCount.Value
            end)

            player.SelectedTeam.Changed:Once(function()
                clone:Destroy()
            end)

            clone.Destroying:Once(function()
                connection:Disconnect()
                connection_2:Disconnect()
                connection_3:Disconnect()
                connection_4:Disconnect()
                connection_5:Disconnect()
                connection_6:Disconnect()
            end)

            local connection_7 = nil
            connection_7 = player.AncestryChanged:Connect(function()
                if not player:IsDescendantOf(game) then
                    clone:Destroy()
                    connection_7:Disconnect()
                end
            end)
        end
    end
end

