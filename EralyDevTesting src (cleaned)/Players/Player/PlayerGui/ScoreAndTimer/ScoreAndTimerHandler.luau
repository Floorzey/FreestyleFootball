function handleAwayTeam()
    local value = team_info.CurrentAwayTeam.Value
    away_team.BackgroundColor3 = values[value]
    away_team.UIStroke.Color = values_2[value]
    away_team.TeamName.TextStrokeColor3 = values_2[value]
    away_team.TeamName.Text = values_3[value]
    away_team.ImageLabel.Image = values_4[value]
    game.Workspace.gameArea.SelectedMap:WaitForChild("Scoreboard").Team2.TeamName.SurfaceGui.Frame.TextLabel.Text =
        values_5[value]
    game.Workspace.gameArea.SelectedMap:WaitForChild("Scoreboard").Team2.TeamName.SurfaceGui.Frame.TextLabel.TextStrokeColor3 =
        values_2[value]
    game.Workspace.gameArea.SelectedMap:WaitForChild("Scoreboard").Team2.TeamName.SurfaceGui.Frame.TextLabel.TextStrokeTransparency =
        1
end

function handleHomeTeam()
    local value = team_info.CurrentHomeTeam.Value
    home_team.BackgroundColor3 = values[value]
    home_team.UIStroke.Color = values_2[value]
    home_team.TeamName.TextStrokeColor3 = values_2[value]
    home_team.TeamName.Text = values_3[value]
    home_team.ImageLabel.Image = values_4[value]
    game.Workspace.gameArea.SelectedMap:WaitForChild("Scoreboard").Team1.TeamName.SurfaceGui.Frame.TextLabel.Text =
