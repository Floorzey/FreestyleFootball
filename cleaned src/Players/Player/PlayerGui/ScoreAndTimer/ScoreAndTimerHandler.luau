function setupTabFrame()
    for _, value in pairs(game.Players:GetPlayers()) do
        if not (value:FindFirstChild("dataLoaded")) or value.SelectedTeam.Value == "N/A" then
            continue
        end
        if not ((((value.SelectedTeam.Value == "Away") and container_2) or container):FindFirstChild(value.Name)) then
            local current_away_team_value = ((value.SelectedTeam.Value == "Away") and team_info.CurrentAwayTeam.Value)
                or team_info.CurrentHomeTeam.Value
            local clone = script.plrInfoTemplate:Clone()
            clone.UIGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, values[current_away_team_value]),
                ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
            })
            clone.UIStroke.UIGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, values_2[current_away_team_value]),
                ColorSequenceKeypoint.new(1, Color3.new(0.294118, 0.294118, 0.294118)),
            })
            clone.plrName.Text = string.upper(value.DisplayName)
            clone.POSITION.Text = value.SelectedPosition.Value
            clone.GOALS.Text = value.GoalsThisGame.Value
            clone.OOB.Text = value.PenaltyCount.Value
            clone.ASSISTS.Text = value.AssistsThisGame.Value
            clone.POINTS.Text = value.Points.Value
            clone.Name = value.Name
            clone.Parent = ((value.SelectedTeam.Value == "Away") and container_2) or container
            local connection = value.SelectedPosition.Changed:Connect(function()
                if not clone:FindFirstChild("POSITION") then
                    return
                end
                clone.POSITION.Text = value.SelectedPosition.Value
            end)
            local connection_2 = value.GoalsThisGame.Changed:Connect(function()
                if not clone:FindFirstChild("GOALS") then
                    return
                end
                clone.GOALS.Text = value.GoalsThisGame.Value
            end)
            local connection_3 = value.PenaltyCount.Changed:Connect(function()
                if not clone:FindFirstChild("OOB") then
                    return
                end
                clone.OOB.Text = value.PenaltyCount.Value
            end)
            local connection_4 = value.AssistsThisGame.Changed:Connect(function()
                if not clone:FindFirstChild("ASSISTS") then
                    return
                end
                clone.ASSISTS.Text = value.AssistsThisGame.Value
            end)
            local connection_5 = value.Points.Changed:Connect(function()
                if not clone:FindFirstChild("POINTS") then
                    return
                end
                clone.POINTS.Text = value.Points.Value
            end)
            local connection_6 = value.OffsideCount.Changed:Connect(function()
                if not clone:FindFirstChild("OFFSIDES") then
                    return
                end
                clone.OFFSIDES.Text = value.OffsideCount.Value
            end)
            value.SelectedTeam.Changed:Once(function()
                clone:Destroy()
            end)
            clone.Destroying:Once(function()
                connection:Disconnect()
                connection_2:Disconnect()
                connection_3:Disconnect()
                connection_4:Disconnect()
                connection_5:Disconnect()
                connection_6:Disconnect()
            end)
            local connection_8 = nil
            local connection_7 = value.AncestryChanged:Connect(function()
                if value:IsDescendantOf(game) then
                    return
                end
                clone:Destroy()
                connection_8:Disconnect()
            end)
            connection_8 = connection_7
        end
    end
end

